# Server
PORT=8080
GIN_MODE=release

# Environment
# Gunakan "development" untuk mode sandbox (OTP default aktif), "production" untuk mode real.
APP_ENV=development
SANDBOX_OTP_CODE=123456

# Database
# Gunakan PostgreSQL connection string (lokal, Supabase pooler, atau Neon).
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# JWT
# Wajib diganti dengan secret acak yang kuat (32+ karakter) di production.
JWT_SECRET=supersecretjwtkey_arisankita_2026

# CORS
# Daftar origin frontend yang diizinkan (pisahkan dengan koma).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SMTP (pengiriman OTP email)
# Development tanpa SMTP: biarkan SMTP_HOST kosong -> kode OTP hanya di-log (sandbox).
# Mailpit (dev):        host=mailpit, port=1025, username/password kosong
# SendGrid (production): host=smtp.sendgrid.net, port=587, username=apikey, password=<api-key>
# Amazon SES (production): host=email-smtp.<region>.amazonaws.com, port=587
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=ArisanKita
SMTP_FROM_ADDR=no-reply@arisankita.id

# Password login (opsional)
# Endpoint POST /api/v1/auth/login memakai kolom users.password_hash (bcrypt) bila terisi.
# Jika password_hash kosong, login jatuh ke kode sandbox (SANDBOX_OTP_CODE) — hanya untuk dev.
# Isi kolom password_hash dengan bcrypt hash, mis.:
#   UPDATE users SET password_hash = '$2a$10$...' WHERE email = 'user@example.com';
