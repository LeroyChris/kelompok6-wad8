# Server
PORT=8080
GIN_MODE=release

# Environment
APP_ENV=development  # gunakan "production" untuk mode real
SANDBOX_OTP_CODE=123456

# Database
# Gunakan Supabase pooler URL atau PostgreSQL connection string anda
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# JWT
# Ganti dengan secret key yang kuat di production
JWT_SECRET=supersecretjwtkey_arisankita_2026

# CORS
# Tambahkan origin frontend anda di deployment
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# SMTP (untuk pengiriman OTP email - wajib untuk mode production)
# Mailpit (development, biaya 0): host=mailpit, port=1025, username/password kosong
# SendGrid (production): host=smtp.sendgrid.net, port=587, username=apikey, password=sendgrid_api_key
# Amazon SES (production): host=email-smtp.us-east-1.amazonaws.com, port=587, username=ses_user, password=ses_password
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=ArisanKita
SMTP_FROM_ADDR=no-reply@arisankita.id

# Password Authentication
# Untuk produksi: tambahkan password_hash ke tabel users di Supabase
# dan settingkan nilai ini ke bcrypt hash dari password pengguna
# Contoh generate: bcrypt.GenerateFromPassword([]byte("password"), bcrypt.DefaultCost)
# Hash contoh: $2a$10$XSoifYbTLaRu7954eBip1eBX.NifJVUpjTSW8bdeBI977UpL5tyM6
# Simpan di users table column: password_hash
APP_DEFAULT_PASSWORD=123456
